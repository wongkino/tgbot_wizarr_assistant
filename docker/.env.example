# Telegram BotFather 發出的 token
TELEGRAM_BOT_TOKEN=

# 允許操作的 Telegram 使用者 ID，以逗號分隔。
# 留空時，機器人只會回覆對方的 ID，不會呼叫 Wizarr。
TELEGRAM_ADMIN_IDS=

# Webhook 密鑰。polling 可不填；改成 webhook 時必填。
TELEGRAM_WEBHOOK_SECRET=

# Wizarr 位址，不要以 /api 結尾也可以，程式會自動補上。
WIZARR_URL=http://host.docker.internal:5690

# Wizarr Settings → API Keys 建立的金鑰
WIZARR_API_KEY=

# 邀請連結使用的對外網址。沒填時會由 WIZARR_URL 推導。
WIZARR_PUBLIC_URL=https://wizarr.example.com

# polling：不需要公開網址
# webhook：由反向代理把更新 POST 到 /telegram
MODE=polling
PORT=8080
