{
  "name": "tgbot-wizarr-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram reply-keyboard bot for the Wizarr API, running on Telegram Serverless.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "tg:bundle": "node scripts/build-serverless.mjs",
    "tg:config": "node --env-file=serverless/.env scripts/write-tg-config.mjs",
    "tg:build": "node scripts/build-serverless.mjs && node --env-file=serverless/.env scripts/write-tg-config.mjs"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
